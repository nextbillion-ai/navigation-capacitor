    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "navigation",
    "nextbillion",
    "ios",
    "android"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
